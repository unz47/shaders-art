{
  "name": "shaders-art",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/flatten-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "verify": "next typegen && tsc --noEmit && eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@anthropic-ai/aws-sdk": "0.7.7",
    "@anthropic-ai/bedrock-sdk": "^0.35.0",
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@aws-sdk/client-dynamodb": "^3.1141.0",
    "@aws-sdk/lib-dynamodb": "^3.1141.0",
    "@frost-ui/react": "^0.1.0",
    "@frost-ui/tokens": "^0.1.0",
    "aws-jwt-verify": "^5.2.1",
    "gifenc": "1.0.3",
    "next": "^16.2.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.183.0",
    "eslint": "^9.19.0",
    "eslint-config-next": "^16.2.9",
    "msw": "^2.15.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "@frost-ui/react": "link:../design-system/packages/react",
      "@frost-ui/tokens": "link:../design-system/packages/tokens"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
