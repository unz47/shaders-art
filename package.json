{
  "name": "shaders-art",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "tsc --noEmit && eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@frost-ui/react": "^0.1.0",
    "@frost-ui/tokens": "^0.1.0",
    "next": "^16.2.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.183.0",
    "eslint": "^9.19.0",
    "eslint-config-next": "^16.2.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "@frost-ui/react": "link:../design-system/packages/react",
      "@frost-ui/tokens": "link:../design-system/packages/tokens"
    }
  }
}
